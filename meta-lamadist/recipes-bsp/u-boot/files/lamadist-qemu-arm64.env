# SPDX-License-Identifier: GPL-2.0-only
#
# The whole default U-Boot environment for the `vm --firmware u-boot`
# QEMU payload (ADR 0013 open question 6), compiled in through
# CONFIG_ENV_DEFAULT_ENV_TEXT_FILE.  The same four variables as the
# board env (lamadist-soquartz.env), with QEMU virt values; it replaces
# board/emulation/qemu-arm/qemu-arm.env.
# Format: mkenvimage key=value lines.

# There is no bootcmd and no bootdelay: CMDLINE is off, so U-Boot boots
# through CONFIG_BOOTSTD_PROG and panics if that fails.

# One device, as the board pins mmc0 and not the SD slot's mmc1: the
# first virtio-blk disk, which the vm task attaches first.  A bare
# "virtio" would scan every virtio disk (boot/bootdev-uclass.c:443-469,
# no seq matches any), so the vm task's --extra-disk, a second
# virtio-blk disk, stands in for the SD card and must be ignored.
# Upstream's list is "qfw usb scsi virtio nvme dhcp" (qemu-arm.env).
boot_targets=virtio0

# Empty on purpose, as on the board: the device tree is QEMU's (or the
# UKI's), never a file on the medium.
fdtfile=

# Load addresses bootmeth_efi reads on the block-device path
# (boot/bootmeth_efi.c:131 for fdt_addr_r, :332 for kernel_addr_r).
# kernel_addr_r is upstream's (qemu-arm.env); U-Boot loads systemd-boot
# there, and systemd-boot loads the UKI itself.  Upstream sets no
# fdt_addr_r; this one sits 128 MiB into RAM, clear of QEMU's device
# tree at the base of RAM (0x40000000) and of the systemd-boot image at
# kernel_addr_r.
kernel_addr_r=0x40400000
fdt_addr_r=0x48000000
