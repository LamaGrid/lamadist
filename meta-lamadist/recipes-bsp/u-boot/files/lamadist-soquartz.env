# SPDX-License-Identifier: GPL-2.0-only
#
# The whole default U-Boot environment for the SOQuartz leaf (ADR 0013
# decision 3), compiled in through CONFIG_ENV_DEFAULT_ENV_TEXT_FILE.  It
# replaces rk3568_common.h's CFG_EXTRA_ENV_SETTINGS, so every variable
# the EFI boot method needs is named here and nothing else is.
# Format: mkenvimage key=value lines.

# There is no bootcmd and no bootdelay: CMDLINE is off, so U-Boot boots
# through CONFIG_BOOTSTD_PROG (common/main.c), standard boot with the EFI
# loader as the only boot method (lamadist-soquartz-efi.cfg), and panics
# if that fails.

# GUESS, owner decision pending: the shipping medium.  Upstream's list
# is "mmc1 mmc0 nvme scsi usb pxe dhcp spi" (rockchip-common.h:17); this
# pins one entry.  The numbering is U-Boot's: rk356x-u-boot.dtsi:10-11
# names the eMMC mmc0 and the SD slot mmc1.  The kernel's board device
# tree reverses it (rk3566-soquartz.dtsi: mmc0 is the SD slot), so under
# Linux the eMMC is mmcblk1 and an SD card is mmcblk0.  The image never
# names the disk; it finds its partitions by PARTLABEL.
boot_targets=mmc0

# Empty on purpose: the device tree ships inside the UKI.  bootmeth_efi
# still calls efi_get_distro_fdt_name (boot/bootmeth_efi.c:137), but
# with no fdtfile, and with OF_HAS_PRIOR_STAGE off (no Rockchip board
# selects it), it returns -ENOENT (lib/efi_loader/efi_fdt.c:75), so no
# device tree file is read from the medium.
fdtfile=

# Load addresses bootmeth_efi reads on the block-device path
# (boot/bootmeth_efi.c:131 for fdt_addr_r, :332 for kernel_addr_r).
# Upstream values, rk3568_common.h:25 and :27.
kernel_addr_r=0x02000000
fdt_addr_r=0x12000000
