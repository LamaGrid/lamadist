# vi:ft=kickstart
# SPDX-License-Identifier: Apache-2.0
#
# LamaDist installer stick layout (increment 1).  Both partitions are
# prebuilt filesystem images staged by lamadist-installer-image.bb's
# do_image_wic prefunc (rootless: mkfs.vfat/mcopy and mkfs.ext4 -d),
# then rawcopied in.  ESP carries the signed installer UKI at
# EFI/BOOT/BOOTX64.EFI (removable-media boot path); the payload
# partition carries the hardened full-disk image, its checksum, the
# manifest, and the manual.
#
# The vault (LUKS2-encrypted payload) and PUBLIC/vault split are the
# security increment; increment 1 uses one plain payload partition.

# No --label on either part: the filesystem labels are baked by
# mkfs (-n ESP, -L lamadist-payload) inside the rawcopied images, so
# wic must not re-run a labeling tool (it picks the wrong one for a
# rawcopy source and fails on ext4).  The ESP is found by firmware via
# its GPT type GUID; the payload by its fs label (udev by-label).
part /esp --source rawcopy --sourceparams="file=${WORKDIR}/stick/esp.vfat" --part-type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B --active --align 1024

part /payload --source rawcopy --sourceparams="file=${WORKDIR}/stick/payload.ext4" --align 1024

bootloader --ptable gpt
