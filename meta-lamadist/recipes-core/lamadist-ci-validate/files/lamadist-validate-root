#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# Privileged half of the CI validation collector.  Runs exactly the
# four check commands that need root and prints their results as a
# JSON object keyed by the command string, for the entrypoint
# (lamadist-validate-device) to merge with the unprivileged facts.
#
# It is reachable only through one NOPASSWD sudoers rule
# (/etc/sudoers.d/lamadist-ci-validate) that names this exact path and
# no arguments, so the CI key can elevate for these four fixed
# commands and nothing else.  It reads no arguments and no stdin.
set -u

exec /usr/bin/python3 - <<'PY'
import json
import subprocess
import sys

# Exactly the "as root" commands the features run, verbatim.
ROOT = [
    "cat /proc/1/attr/current",
    "cryptsetup luksDump $(cryptsetup status $(basename $(awk '$2 == \"/var\" {print $1}' /proc/mounts)) | awk '/^ *device:/ {print $2}')",
    "dmsetup info -c --noheadings -o uuid $(awk '$2 == \"/var\" {print $1}' /proc/mounts)",
    "wc -l < /sys/kernel/security/ima/ascii_runtime_measurements",
]

facts = {}
for cmd in ROOT:
    proc = subprocess.run(["/bin/sh", "-c", cmd], capture_output=True, text=True)
    facts[cmd] = {"rc": proc.returncode, "stdout": proc.stdout, "stderr": proc.stderr}

json.dump(facts, sys.stdout)
PY
