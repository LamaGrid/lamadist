# LamaDist installer manifest (SPEC section 5).  Strict KEY=VALUE,
# LF-only, no whitespace around '='.  Copy to manifest.env on the
# payload partition to drive a headless install.  Remove or leave
# HEADLESS=no for an interactive install (values become prompt
# pre-fills).
#
# Increment 1 consumes TARGET_DISK, CONFIRM, and HEADLESS.  The
# remaining keys are recognized (so the schema is stable) but not yet
# acted on: hostname/network config and the enrollment/unlock keys
# arrive with the provisioning and vault increments.
MANIFEST_VERSION=1
HOSTNAME=node-01
NET_MODE=dhcp
NET_INTERFACE=auto
TARGET_DISK=auto
CONFIRM=auto
UNLOCK_SOURCE=prompt
ENROLL=no
TPM_OPTIONAL=no
HEADLESS=no
