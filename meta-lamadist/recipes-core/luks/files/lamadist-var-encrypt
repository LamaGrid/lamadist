#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
#
# ExecStart for lamadist-var-encrypt.service.  One-way migration
# (M4 plan decision 4): the wic-built 'var' PARTLABEL partition
# starts out as a plain, empty ext4 filesystem with no LUKS2 header
# (see the lamadist_fstab_var comment in lamadist-image.bbclass);
# the first boot that finds it that way luksFormats it in place with
# the DEVELOPMENT-ONLY keyfile below and mkfs.ext4's the mapped
# device.  Every later boot's crypttab 'var' entry
# (lamadist-image.bbclass) just unlocks the header this script
# already wrote -- the blkid check below makes that boot's run of
# this script a no-op, and self-heals (re-runs mkfs.ext4) if an
# earlier boot lost power between luksFormat and mkfs.ext4.
#
# TPM2 seal seam (stage B, W11): this script only ever writes/reads
# LUKS keyslot 0 (the keyfile).  systemd-cryptenroll adds a TPM2
# keyslot alongside it without touching this script or the keyfile
# slot; nothing here needs to change for that to land.

set -eu

DEV=/dev/disk/by-partlabel/var
KEYFILE=/etc/lamadist/dev-var.key
# NOT "var": crypttab maps this partition as "var", so systemd holds
# BindsTo=dev-mapper-var.device relationships for the fsck/mount
# chain.  When this script's TRANSIENT open appeared as
# /dev/mapper/var and then closed, udev reported the device gone and
# systemd enqueued replace-mode stop jobs whose cascade CANCELED the
# held-back local-fs.target/sysinit start chain -- /etc overlay,
# sshdgenkeys, and local-fs.target simply never ran (captured live
# with systemd.log_level=debug: "local-fs.target/start finished,
# result=canceled").  A name systemd has no unit relationships with
# keeps the transient open invisible to the boot transaction.
MAPPER_NAME=var-firstboot
MAPPER_DEV="/dev/mapper/${MAPPER_NAME}"

# DefaultDependencies=no (see the unit file) means udev is not
# guaranteed to have settled by the time this runs; wait for
# ${DEV} to show up rather than hand-wiring an ordering dependency
# on the generated by-partlabel .device unit.
udevadm settle --timeout=30

if ! cryptsetup isLuks "${DEV}"; then
	echo "lamadist-var-encrypt: no LUKS2 header on ${DEV}, formatting (DEVELOPMENT-ONLY keyfile)" >&2
	# pbkdf2 with a floor iteration count, NOT the argon2id default:
	# the keyslot passphrase is a 256-bit (32-byte) random keyfile,
	# so the KDF
	# adds no brute-force protection worth having, while memory-hard
	# argon2id benchmarks itself against available RAM and costs
	# real time on small machines EVERY unlock, every boot (it ate
	# most of the 300s CI smoke budget on the 512M QEMU guest).
	# TPM2 enrollment (stage B, W11) adds its own keyslot with its
	# own policy; this only governs the dev keyfile slot.
	cryptsetup luksFormat --type luks2 --batch-mode \
		--pbkdf pbkdf2 --pbkdf-force-iterations 1000 \
		--key-file "${KEYFILE}" "${DEV}"
fi

cryptsetup open --key-file "${KEYFILE}" "${DEV}" "${MAPPER_NAME}"

# isLuks only proves the LUKS2 header was written; it says nothing
# about mkfs.ext4 below ever having run.  A power loss between
# luksFormat and mkfs.ext4 on an earlier boot leaves a valid header
# over an unformatted mapper, and isLuks alone would treat that as
# "already migrated" forever, permanently bricking /var.  Check the
# mapped device's actual filesystem and (re-)format only when it is
# missing, so an interrupted first boot self-heals on the next one --
# still safe under the "no data yet" invariant below.
if [ "$(blkid -o value -s TYPE "${MAPPER_DEV}" 2>/dev/null)" != "ext4" ]; then
	echo "lamadist-var-encrypt: ${MAPPER_DEV} has no ext4 filesystem, formatting" >&2
	mkfs.ext4 -q -L var "${MAPPER_DEV}"

	# Seed the fresh filesystem from the build-time /var.  This
	# service runs before crypttab's own mapping and var.mount, so
	# /var here is still the read-only root's seed directory --
	# var.mount will later shadow it ("Directory /var to mount over
	# is not empty").  Without the copy, /var comes up EMPTY: no
	# /var/volatile mountpoint for the volatile binds, no /var/lib
	# skeleton, and every consumer of build-time /var state runs
	# degraded.  cp -a (coreutils, see the recipe's RDEPENDS)
	# preserves the xattrs, so the seeded tree keeps its SELinux
	# labels; the fs root inode gets its label copied explicitly
	# (best-effort: pre-policy-load or non-SELinux boots have
	# nothing to copy).
	_seed_mnt="$(mktemp -d)"
	mount -t ext4 "${MAPPER_DEV}" "${_seed_mnt}"
	cp -a /var/. "${_seed_mnt}/"
	chcon --reference=/var "${_seed_mnt}" 2>/dev/null || true
	umount "${_seed_mnt}"
	rmdir "${_seed_mnt}"
fi

# The crypttab-driven systemd-cryptsetup@var.service (ordered after
# cryptsetup-pre.target, see the unit file) creates the real "var"
# mapping var.mount uses; closing this differently-named transient
# one frees the LUKS device for it without ever touching
# dev-mapper-var.device (see MAPPER_NAME above).
cryptsetup close "${MAPPER_NAME}"
