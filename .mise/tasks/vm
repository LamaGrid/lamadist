#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#MISE description="Launch QEMU VM with SPICE display"
#USAGE flag "-b --bsp <bsp>" help="BSP target to boot" default="x86_64" {
#USAGE   choices "x86_64"
#USAGE }
#USAGE flag "-t --timeout <timeout>" help="Boot timeout in seconds (CI mode)" default="300"
#USAGE flag "-c --ci" help="CI mode (headless login smoke test)"
#USAGE flag "-H --headless" help="Headless-interactive mode: serial/monitor unix sockets + ssh port-forward"
#USAGE flag "-p --ssh-port <port>" help="Host port forwarded to guest :22 (headless mode)" default="2222"
#USAGE flag "-R --allow-reboot" help="Let the guest actually reset QEMU on reboot instead of exiting (needed to drive multi-reboot tests)"
#USAGE flag "-s --snapshot" help="Discard all disk writes on exit (headless/interactive mode; CI mode always snapshots)"
#USAGE flag "-T --tmpdir <tmpdir>" help="Reuse this dir for ephemeral VM state instead of creating one, so callers can predict socket paths"
set -o errexit
set -o nounset
set -o pipefail

_bsp="${usage_bsp:-x86_64}"
_timeout="${usage_timeout:-300}"
_ci="${usage_ci:-false}"
_headless="${usage_headless:-false}"
_ssh_port="${usage_ssh_port:-2222}"
_allow_reboot="${usage_allow_reboot:-false}"
_snapshot="${usage_snapshot:-false}"
_tmpdir="${usage_tmpdir:-}"

# shellcheck source=.mise/tasks/_lib.sh
source "${MISE_CONFIG_ROOT}/.mise/tasks/_lib.sh"
_machine=$(bsp_to_machine "${_bsp}")
_deploy_dir="${LAMADIST_HOST_DEPLOY_DIR}/images/${_machine}"

# OVMF firmware paths
_ovmf_code="/usr/share/edk2/OvmfX64/OVMF_CODE.fd"
_ovmf_vars_template="/usr/share/edk2/OvmfX64/OVMF_VARS.fd"

# Temp directory for ephemeral state (OVMF vars, swtpm).  A caller
# driving multi-reboot tests supplies --tmpdir so it knows the
# socket paths ahead of time instead of parsing stdout.
if [[ -n "${_tmpdir}" ]]; then
	mkdir -p "${_tmpdir}"
	_qemu_tmpdir="${_tmpdir}"
else
	_qemu_tmpdir=$(mktemp -d /tmp/qemu-lamadist.XXXXXX)
fi

cleanup() {
	local pids=("${_spicy_pid:-}" "${_swtpm_pid:-}")
	for pid in "${pids[@]}"; do
		[[ -n "${pid}" ]] && kill "${pid}" 2>/dev/null || true
	done
	# Only remove a tmpdir this task created itself; a caller-supplied
	# --tmpdir is documented (above) as reusable/predictable, so the
	# caller owns its lifecycle (e.g. .mise/tasks/test-ota's own
	# cleanup() removes the same directory).
	[[ -z "${_tmpdir}" ]] && rm -rf "${_qemu_tmpdir}"
}
trap cleanup EXIT

# --- Prerequisites ---

_required_tools=(qemu-system-x86_64 swtpm)
if [[ "${_ci}" != "true" && "${_headless}" != "true" ]]; then
	_required_tools+=(spicy)
fi
for tool in "${_required_tools[@]}"; do
	command -v "${tool}" >/dev/null || { echo "ERROR: ${tool} not found"; exit 1; }
done
[[ -f "${_ovmf_code}" ]] || { echo "ERROR: OVMF firmware not found at ${_ovmf_code}"; exit 1; }
[[ -f "${_ovmf_vars_template}" ]] || { echo "ERROR: OVMF VARS template not found at ${_ovmf_vars_template}"; exit 1; }

# --- Find WIC image ---
# Newest by mtime across compressed and uncompressed candidates,
# so a stale decompression leftover never shadows a fresh build.

_wic_image=$(find "${_deploy_dir}" -maxdepth 1 \( -name "*.wic" -o -name "*.wic.zst" -o -name "*.wic.xz" -o -name "*.wic.gz" -o -name "*.wic.bz2" \) -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-)
[[ -n "${_wic_image}" ]] || { echo "ERROR: No WIC image found in ${_deploy_dir}"; exit 1; }
if [[ "${_wic_image}" != *.wic ]]; then
	echo "==> Decompressing ${_wic_image}..."
	case "${_wic_image}" in
		*.zst) zstd -d -k -f "${_wic_image}" ;;
		*.xz)  xz -d -k -f "${_wic_image}" ;;
		*.gz)  gunzip -k -f "${_wic_image}" ;;
		*.bz2) bzip2 -d -k -f "${_wic_image}" ;;
	esac
	_wic_image="${_wic_image%.*}"
fi

# --- Prepare OVMF VARS (writable copy) ---

cp "${_ovmf_vars_template}" "${_qemu_tmpdir}/OVMF_VARS.fd"

# --- Start swtpm (TPM 2.0 emulator) ---

mkdir -p "${_qemu_tmpdir}/tpm"
swtpm socket \
	--tpmstate dir="${_qemu_tmpdir}/tpm" \
	--ctrl type=unixio,path="${_qemu_tmpdir}/tpm/sock" \
	--tpm2 \
	--daemon \
	--pid file="${_qemu_tmpdir}/tpm/pid"

# Wait for swtpm socket
for _ in $(seq 1 20); do
	[[ -S "${_qemu_tmpdir}/tpm/sock" ]] && break
	sleep 0.1
done
[[ -S "${_qemu_tmpdir}/tpm/sock" ]] || { echo "ERROR: swtpm failed to start"; exit 1; }
_swtpm_pid=$(cat "${_qemu_tmpdir}/tpm/pid")

# --- KVM acceleration ---

_accel_args=()
if [[ -r /dev/kvm ]]; then
	_accel_args=(-enable-kvm -cpu host)
else
	echo "==> WARNING: KVM not available, using TCG (slow)"
	_accel_args=(-cpu IvyBridge)
fi

# --- Build QEMU command ---

# user-mode networking; headless/CI modes forward a host port to
# guest sshd for agents and tests
_netdev='user,id=net0'
if [[ "${_ci}" == "true" || "${_headless}" == "true" ]]; then
	_netdev="${_netdev},hostfwd=tcp:127.0.0.1:${_ssh_port}-:22"
fi

# -no-reboot turns a guest-issued reboot into a QEMU exit, which is
# right for the single-shot CI login smoke but wrong for multi-boot
# tests (OTA install/rollback) that need QEMU to actually reset and
# keep running.
_reboot_args=(-no-reboot)
if [[ "${_allow_reboot}" == "true" ]]; then
	_reboot_args=()
fi

_qemu_args=(
	"${_accel_args[@]}"
	-machine q35
	-m 512 -smp 4
	-drive "if=pflash,format=raw,readonly=on,file=${_ovmf_code}"
	-drive "if=pflash,format=raw,file=${_qemu_tmpdir}/OVMF_VARS.fd"
	-drive "file=${_wic_image},format=raw,if=none,id=hd0"
	-device 'ahci,id=ahci0'
	-device 'ide-hd,drive=hd0,bus=ahci0.0'
	-netdev "${_netdev}"
	-device 'virtio-net-pci,netdev=net0'
	-object 'rng-random,filename=/dev/urandom,id=rng0'
	-device 'virtio-rng-pci,rng=rng0'
	-chardev "socket,id=chrtpm,path=${_qemu_tmpdir}/tpm/sock"
	-tpmdev 'emulator,id=tpm0,chardev=chrtpm'
	-device 'tpm-crb,tpmdev=tpm0'
	-usb -device usb-tablet
	"${_reboot_args[@]}"
)

# Serial console as a unix socket (server, no wait) with a mirror
# logfile: agents/tests attach to the socket, humans read the log.
# The socket lives in the short mktemp dir to stay under the
# 108-char sun_path limit.
_serial_sock="${_qemu_tmpdir}/serial.sock"
_serial_log="${_qemu_tmpdir}/serial.log"
_serial_chardev="socket,id=ser0,path=${_serial_sock},server=on,wait=off,logfile=${_serial_log}"

# CI mode always snapshots (throwaway single-shot smoke run);
# headless/interactive mode only snapshots on request, since a human
# or agent driving --headless directly may want writes to persist.
_snapshot_args=()
if [[ "${_ci}" == "true" || "${_snapshot}" == "true" ]]; then
	_snapshot_args=(-snapshot)
fi

if [[ "${_ci}" == "true" ]]; then
	# --- CI mode: headless login smoke test with timeout ---
	echo "==> CI login smoke test: image=${_wic_image}"
	echo "==> Timeout: ${_timeout}s"

	timeout "$((_timeout + 30))" qemu-system-x86_64 \
		"${_qemu_args[@]}" \
		"${_snapshot_args[@]}" \
		-display none \
		-chardev "${_serial_chardev}" \
		-serial chardev:ser0 &
	_qemu_pid=$!

	_smoke_rc=0
	python3 "${MISE_CONFIG_ROOT}/.mise/lib/smoke_login.py" \
		"${_serial_sock}" lama lamadist "${_timeout}" || _smoke_rc=$?

	kill "${_qemu_pid}" 2>/dev/null || true
	wait "${_qemu_pid}" 2>/dev/null || true

	if [[ "${_smoke_rc}" -eq 0 ]]; then
		echo "==> QEMU login smoke test PASSED"
	else
		echo "==> QEMU login smoke test FAILED"
		echo "==> Last 50 lines of serial log:"
		tail -50 "${_serial_log}" 2>/dev/null || true
		exit 1
	fi
elif [[ "${_headless}" == "true" ]]; then
	# --- Headless-interactive mode: sockets for agents/CI ---
	_monitor_sock="${_qemu_tmpdir}/monitor.sock"

	echo "==> Image: ${_wic_image}"
	echo "==> Serial console socket: ${_serial_sock}"
	echo "==> Serial transcript:     ${_serial_log}"
	echo "==> QEMU monitor socket:   ${_monitor_sock}"
	echo "==> Guest ssh forwarded to 127.0.0.1:${_ssh_port}"
	echo "==> Attach: socat -,raw,echo=0 UNIX-CONNECT:${_serial_sock}"

	qemu-system-x86_64 \
		"${_qemu_args[@]}" \
		"${_snapshot_args[@]}" \
		-display none \
		-chardev "${_serial_chardev}" \
		-serial chardev:ser0 \
		-monitor "unix:${_monitor_sock},server=on,wait=off"
else
	# --- Interactive mode: SPICE display + serial console ---
	_spice_port=5930

	echo "==> Image: ${_wic_image}"
	echo "==> SPICE display on port ${_spice_port}"
	echo "==> Keyboard release: Shift+F12"
	echo "==> Type 'quit' in this terminal to stop QEMU"

	spicy --host=localhost --port="${_spice_port}" &
	_spicy_pid=$!

	qemu-system-x86_64 \
		"${_qemu_args[@]}" \
		"${_snapshot_args[@]}" \
		-device qxl-vga \
		-spice port="${_spice_port}",disable-ticketing=on \
		-serial mon:stdio
fi
