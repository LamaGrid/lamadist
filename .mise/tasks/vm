#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#MISE description="Launch QEMU VM with SPICE display"
#USAGE flag "-b --bsp <bsp>" help="BSP target to boot (x86_64: q35 + OVMF; qemuarm64: virt + AAVMF, always TCG on an x86 host)" default="x86_64" {
#USAGE   choices "x86_64" "qemuarm64"
#USAGE }
#USAGE flag "-P --profile <profile>" help="qemuarm64 only: shape the virt machine like a target board (CPU model, cores, memory) instead of the generic default; no board firmware or peripherals are emulated" default="default" {
#USAGE   choices "default" "rk1" "soquartz" "orin-nx"
#USAGE }
#USAGE flag "-t --timeout <timeout>" help="Boot timeout in seconds (CI mode); qemuarm64 under TCG needs ~900" default="300"
#USAGE flag "-c --ci" help="CI mode (headless login smoke test)"
#USAGE flag "-H --headless" help="Headless-interactive mode: serial/monitor unix sockets + ssh port-forward"
#USAGE flag "-p --ssh-port <port>" help="Host port forwarded to guest :22 (headless mode)" default="2222"
#USAGE flag "-R --allow-reboot" help="Let the guest actually reset QEMU on reboot instead of exiting (needed to drive multi-reboot tests)"
#USAGE flag "-s --snapshot" help="Discard all disk writes on exit (headless/interactive mode; CI mode always snapshots)"
#USAGE flag "-T --tmpdir <tmpdir>" help="Reuse this dir for ephemeral VM state instead of creating one, so callers can predict socket paths"
#USAGE flag "-S --secureboot" help="Boot Secure Boot firmware (OVMF_CODE.secboot.fd) with the pre-enrolled PK/KEK/db vars artifact (M4 stage B, W10); build the artifact first with .mise/tasks/ovmf-vars"
set -o errexit
set -o nounset
set -o pipefail

_bsp="${usage_bsp:-x86_64}"
_profile="${usage_profile:-default}"
_timeout="${usage_timeout:-300}"
_ci="${usage_ci:-false}"
_headless="${usage_headless:-false}"
_ssh_port="${usage_ssh_port:-2222}"
_allow_reboot="${usage_allow_reboot:-false}"
_snapshot="${usage_snapshot:-false}"
_tmpdir="${usage_tmpdir:-}"
_secureboot="${usage_secureboot:-false}"

# shellcheck source=.mise/tasks/_lib.sh
source "${MISE_CONFIG_ROOT}/.mise/tasks/_lib.sh"
_machine=$(bsp_to_machine "${_bsp}")
_deploy_dir="${LAMADIST_HOST_DEPLOY_DIR}/images/${_machine}"

# Architecture split.  x86_64 keeps its q35 + OVMF + AHCI shape; the
# aarch64 target boots qemu's virt machine under AAVMF with virtio
# storage.  Everything downstream (swtpm, serial socket, smoke) is
# shared, so a green aarch64 run proves the same properties.
case "${_bsp}" in
	qemuarm64) _arch=aarch64 ;;
	*) _arch=x86_64 ;;
esac
_qemu="qemu-system-${_arch}"
if [[ "${_profile}" != "default" && "${_arch}" != "aarch64" ]]; then
	echo "ERROR: --profile ${_profile} only applies to --bsp qemuarm64"
	exit 1
fi

# The edk2 firmware for the guest.  Distros ship the same edk2 builds
# under different names, so the first readable candidate wins and an
# environment override takes precedence.  Vars templates are copied
# fresh per run (firmware writes them).
first_readable() {
	local _f
	for _f in "$@"; do
		[[ -n "${_f}" && -r "${_f}" ]] && { echo "${_f}"; return 0; }
	done
	return 1
}
if [[ "${_arch}" == "aarch64" ]]; then
	_fw_name="AAVMF"
	_fw_code_default=$(first_readable "${LAMADIST_AAVMF_CODE:-}" \
		/usr/share/qemu/edk2-aarch64-code.fd \
		/usr/share/AAVMF/AAVMF_CODE.fd \
		/usr/share/edk2/aarch64/QEMU_EFI-pflash.raw) || _fw_code_default=""
	_fw_vars_default=$(first_readable "${LAMADIST_AAVMF_VARS:-}" \
		/usr/share/qemu/edk2-arm-vars.fd \
		/usr/share/AAVMF/AAVMF_VARS.fd \
		/usr/share/edk2/aarch64/vars-template-pflash.raw) || _fw_vars_default=""
	# Secure Boot capable AAVMF.  qemu's own edk2 build has SB compiled
	# out, so this is a separate artifact: Gentoo ships it as qcow2
	# (the INSECURE suffix records that ArmVirt has no SMM to isolate
	# the variable store, which is fine for a boot gate), Debian family
	# builds SB into the default image.
	_fw_sb_code=$(first_readable "${LAMADIST_AAVMF_SB_CODE:-}" \
		/usr/share/edk2/ArmVirtQemu-AARCH64/QEMU_EFI.secboot_INSECURE.qcow2 \
		/usr/share/AAVMF/AAVMF_CODE.secboot.fd \
		/usr/share/AAVMF/AAVMF_CODE.fd) || _fw_sb_code=""
	_fw_sb_vars_host=$(first_readable "${LAMADIST_AAVMF_SB_VARS:-}" \
		/usr/share/edk2/ArmVirtQemu-AARCH64/QEMU_VARS.secboot_INSECURE.qcow2 \
		/usr/share/AAVMF/AAVMF_VARS.secboot.fd \
		/usr/share/AAVMF/AAVMF_VARS.fd) || _fw_sb_vars_host=""
else
	_fw_name="OVMF"
	_fw_code_default="/usr/share/edk2/OvmfX64/OVMF_CODE.fd"
	_fw_vars_default="/usr/share/edk2/OvmfX64/OVMF_VARS.fd"
	_fw_sb_code="/usr/share/edk2/OvmfX64/OVMF_CODE.secboot.fd"
	_fw_sb_vars_host="/usr/share/edk2/OvmfX64/OVMF_VARS.fd"
fi

# --secureboot swaps in the SB-capable code image and a pre-enrolled
# (PK/KEK/db) vars template instead of the default unenrolled one; the
# enrolled-vars artifact is built by `.mise/tasks/ovmf-vars` into the
# same per-machine deploy dir as the WIC image.  If that task has not
# been run yet, --secureboot errors clearly: it fails the firmware-
# presence check below instead of doing anything silently wrong.
# Normal (no --secureboot) boots are untouched.
if [[ "${_secureboot}" == "true" ]]; then
	_ovmf_code="${_fw_sb_code}"
	_ovmf_vars_template="${_deploy_dir}/ovmf-vars-enrolled.fd"
	echo "==> Secure Boot: ${_ovmf_code##*/} + enrolled vars (${_ovmf_vars_template})"
	# Drift guard: the enrolled artifact is derived from the host's
	# vars template, and a host edk2 upgrade silently changes that
	# template.  ovmf-vars records the template hash in a sidecar; a
	# mismatch here means the artifact is stale and the SB state under
	# test is no longer what it claims to be.
	_vars_sidecar="${_ovmf_vars_template}.template.sha256"
	if [[ -f "${_vars_sidecar}" ]]; then
		# The sidecar records the host template the enrolled artifact was
		# derived from.  If that template is now unreadable we cannot
		# confirm the artifact is current, so this fails closed rather
		# than booting an unverifiable Secure Boot state.
		if [[ -z "${_fw_sb_vars_host}" || ! -r "${_fw_sb_vars_host}" ]]; then
			echo "ERROR: the enrolled vars artifact records a template hash, but the"
			echo "       host Secure Boot vars template is missing, so its currency"
			echo "       cannot be checked; rebuild the enrolled artifact with the"
			echo "       ovmf-vars task"
			exit 1
		fi
		_host_vars_hash=$(sha256sum "${_fw_sb_vars_host}" | awk '{print $1}')
		if [[ "${_host_vars_hash}" != "$(cat "${_vars_sidecar}")" ]]; then
			echo "ERROR: host ${_fw_sb_vars_host##*/} changed since the enrolled vars"
			echo "       were built; rebuild the enrolled artifact with the ovmf-vars task"
			exit 1
		fi
	fi
else
	_ovmf_code="${_fw_code_default}"
	_ovmf_vars_template="${_fw_vars_default}"
fi
# pflash accepts raw and qcow2 images; qemu will not guess for pflash.
_fw_format() { [[ "$1" == *.qcow2 ]] && echo qcow2 || echo raw; }

# Temp directory for ephemeral state (OVMF vars, swtpm).  A caller
# driving multi-reboot tests supplies --tmpdir so it knows the
# socket paths ahead of time instead of parsing stdout.
if [[ -n "${_tmpdir}" ]]; then
	mkdir -p "${_tmpdir}"
	_qemu_tmpdir="${_tmpdir}"
else
	_qemu_tmpdir=$(mktemp -d /tmp/qemu-lamadist.XXXXXX)
fi

cleanup() {
	local pids=("${_spicy_pid:-}" "${_swtpm_pid:-}")
	for pid in "${pids[@]}"; do
		[[ -n "${pid}" ]] && kill "${pid}" 2>/dev/null || true
	done
	# Only remove a tmpdir this task created itself; a caller-supplied
	# --tmpdir is documented (above) as reusable/predictable, so the
	# caller owns its lifecycle (e.g. .mise/tasks/test-ota's own
	# cleanup() removes the same directory).
	[[ -z "${_tmpdir}" ]] && rm -rf "${_qemu_tmpdir}"
}
trap cleanup EXIT

# --- Prerequisites ---

_required_tools=("${_qemu}" swtpm)
if [[ "${_ci}" != "true" && "${_headless}" != "true" ]]; then
	_required_tools+=(spicy)
fi
for tool in "${_required_tools[@]}"; do
	command -v "${tool}" >/dev/null || { echo "ERROR: ${tool} not found"; exit 1; }
done
[[ -n "${_ovmf_code}" && -f "${_ovmf_code}" ]] || { echo "ERROR: ${_fw_name} firmware not found (${_ovmf_code:-no candidate readable})"; exit 1; }
[[ -n "${_ovmf_vars_template}" && -f "${_ovmf_vars_template}" ]] || { echo "ERROR: ${_fw_name} VARS template not found (${_ovmf_vars_template:-no candidate readable})"; exit 1; }

# --- Find WIC image ---
# Newest by mtime across compressed and uncompressed candidates,
# so a stale decompression leftover never shadows a fresh build.

_wic_image=$(find "${_deploy_dir}" -maxdepth 1 \( -name "*.wic" -o -name "*.wic.zst" -o -name "*.wic.xz" -o -name "*.wic.gz" -o -name "*.wic.bz2" \) -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-)
[[ -n "${_wic_image}" ]] || { echo "ERROR: No WIC image found in ${_deploy_dir}"; exit 1; }
if [[ "${_wic_image}" != *.wic ]]; then
	echo "==> Decompressing ${_wic_image}..."
	case "${_wic_image}" in
		*.zst) zstd -d -k -f "${_wic_image}" ;;
		*.xz)  xz -d -k -f "${_wic_image}" ;;
		*.gz)  gunzip -k -f "${_wic_image}" ;;
		*.bz2) bzip2 -d -k -f "${_wic_image}" ;;
	esac
	_wic_image="${_wic_image%.*}"
fi

# --- Prepare firmware VARS (writable copy) ---

_vars_ext="${_ovmf_vars_template##*.}"
_vars_copy="${_qemu_tmpdir}/OVMF_VARS.${_vars_ext}"
cp "${_ovmf_vars_template}" "${_vars_copy}"

# --- Start swtpm (TPM 2.0 emulator) ---

mkdir -p "${_qemu_tmpdir}/tpm"
swtpm socket \
	--tpmstate dir="${_qemu_tmpdir}/tpm" \
	--ctrl type=unixio,path="${_qemu_tmpdir}/tpm/sock" \
	--tpm2 \
	--daemon \
	--pid file="${_qemu_tmpdir}/tpm/pid"

# Wait for swtpm socket
for _ in $(seq 1 20); do
	[[ -S "${_qemu_tmpdir}/tpm/sock" ]] && break
	sleep 0.1
done
[[ -S "${_qemu_tmpdir}/tpm/sock" ]] || { echo "ERROR: swtpm failed to start"; exit 1; }
_swtpm_pid=$(cat "${_qemu_tmpdir}/tpm/pid")

# --- Machine shape and acceleration ---

# KVM only helps when the host runs the guest's architecture; an
# aarch64 guest on an x86 host is always TCG.  The TCG CPU model for
# x86 stays a plain IvyBridge; for aarch64 it comes from the profile.
#
# Preliminary board profiles give the virt machine the CPU model, core
# count, and memory of a real target so the emulated boot exercises
# that shape.  TCG has no big.LITTLE, no board firmware, and none of
# the SoC peripherals, so a green run proves the OS stack, never the
# board bring-up; newer CPU models also need qemu >= 8 (a55, a78ae).
case "${_profile}" in
	default) _cpu=cortex-a57 _smp=2 _mem=2048 ;;
	rk1) _cpu=cortex-a76 _smp=8 _mem=8192 ;;        # RK3588: 4xA76 + 4xA55, 8-32 GiB
	soquartz) _cpu=cortex-a55 _smp=4 _mem=4096 ;;   # RK3566: 4xA55, 2-8 GiB
	orin-nx) _cpu=cortex-a78ae _smp=6 _mem=8192 ;;  # Orin NX 8 GB: 6xA78AE
esac
_accel_args=()
if [[ "${_arch}" == "$(uname -m)" && -r /dev/kvm ]]; then
	_accel_args=(-enable-kvm -cpu host)
elif [[ "${_arch}" == "aarch64" ]]; then
	echo "==> ${_arch} guest on a $(uname -m) host: TCG (slow), profile ${_profile} (${_cpu}, ${_smp} cores, ${_mem} MiB)"
	_accel_args=(-cpu "${_cpu}")
else
	echo "==> WARNING: KVM not available, using TCG (slow)"
	_accel_args=(-cpu IvyBridge)
fi

# The virt machine: GICv3, and acpi=off so the firmware hands the
# kernel a device tree (the qemuarm64 kernel has no ACPI support;
# see conf/machine/qemuarm64-lamadist.conf).  A TPM on virt is the
# memory-mapped TIS device; CRB is x86-only.
if [[ "${_arch}" == "aarch64" ]]; then
	_machine_args=(-machine "virt,gic-version=3,acpi=off" -m "${_mem}" -smp "${_smp}")
	_disk_args=(-device 'virtio-blk-pci,drive=hd0,bootindex=0')
	_tpm_device='tpm-tis-device,tpmdev=tpm0'
	_input_args=()
else
	_machine_args=(-machine q35 -m 512 -smp 4)
	_disk_args=(-device 'ahci,id=ahci0' -device 'ide-hd,drive=hd0,bus=ahci0.0')
	_tpm_device='tpm-crb,tpmdev=tpm0'
	_input_args=(-usb -device usb-tablet)
fi

# --- Build QEMU command ---

# user-mode networking; headless/CI modes forward a host port to
# guest sshd for agents and tests
_netdev='user,id=net0'
if [[ "${_ci}" == "true" || "${_headless}" == "true" ]]; then
	_netdev="${_netdev},hostfwd=tcp:127.0.0.1:${_ssh_port}-:22"
fi

# -no-reboot turns a guest-issued reboot into a QEMU exit, which is
# right for the single-shot CI login smoke but wrong for multi-boot
# tests (OTA install/rollback) that need QEMU to actually reset and
# keep running.
_reboot_args=(-no-reboot)
if [[ "${_allow_reboot}" == "true" ]]; then
	_reboot_args=()
fi

_qemu_args=(
	"${_accel_args[@]}"
	"${_machine_args[@]}"
	-drive "if=pflash,format=$(_fw_format "${_ovmf_code}"),readonly=on,file=${_ovmf_code}"
	-drive "if=pflash,format=$(_fw_format "${_vars_copy}"),file=${_vars_copy}"
	-drive "file=${_wic_image},format=raw,if=none,id=hd0"
	"${_disk_args[@]}"
	-netdev "${_netdev}"
	-device 'virtio-net-pci,netdev=net0'
	-object 'rng-random,filename=/dev/urandom,id=rng0'
	-device 'virtio-rng-pci,rng=rng0'
	-chardev "socket,id=chrtpm,path=${_qemu_tmpdir}/tpm/sock"
	-tpmdev 'emulator,id=tpm0,chardev=chrtpm'
	-device "${_tpm_device}"
	"${_input_args[@]}"
	"${_reboot_args[@]}"
)

# Serial console as a unix socket (server, no wait) with a mirror
# logfile: agents/tests attach to the socket, humans read the log.
# The socket lives in the short mktemp dir to stay under the
# 108-char sun_path limit.
_serial_sock="${_qemu_tmpdir}/serial.sock"
_serial_log="${_qemu_tmpdir}/serial.log"
_serial_chardev="socket,id=ser0,path=${_serial_sock},server=on,wait=off,logfile=${_serial_log}"

# CI mode always snapshots (throwaway single-shot smoke run);
# headless/interactive mode only snapshots on request, since a human
# or agent driving --headless directly may want writes to persist.
_snapshot_args=()
if [[ "${_ci}" == "true" || "${_snapshot}" == "true" ]]; then
	_snapshot_args=(-snapshot)
fi

if [[ "${_ci}" == "true" ]]; then
	# --- CI mode: headless login smoke test with timeout ---
	echo "==> CI login smoke test: image=${_wic_image}"
	echo "==> Timeout: ${_timeout}s"

	timeout "$((_timeout + 30))" "${_qemu}" \
		"${_qemu_args[@]}" \
		"${_snapshot_args[@]}" \
		-display none \
		-chardev "${_serial_chardev}" \
		-serial chardev:ser0 &
	_qemu_pid=$!

	_smoke_rc=0
	_smoke_args=("${_serial_sock}" lama lamadist "${_timeout}")
	# Stage-B gate: the smoke itself must prove Secure Boot is
	# enabled in-guest, not just that SB firmware was selected.
	[[ "${_secureboot}" == "true" ]] && _smoke_args+=(secureboot)
	python3 "${MISE_CONFIG_ROOT}/.mise/lib/smoke_login.py" \
		"${_smoke_args[@]}" || _smoke_rc=$?

	kill "${_qemu_pid}" 2>/dev/null || true
	wait "${_qemu_pid}" 2>/dev/null || true

	if [[ "${_smoke_rc}" -eq 0 ]]; then
		echo "==> QEMU login smoke test PASSED"
	else
		echo "==> QEMU login smoke test FAILED"
		echo "==> Last 50 lines of serial log:"
		tail -50 "${_serial_log}" 2>/dev/null || true
		exit 1
	fi
elif [[ "${_headless}" == "true" ]]; then
	# --- Headless-interactive mode: sockets for agents/CI ---
	_monitor_sock="${_qemu_tmpdir}/monitor.sock"

	echo "==> Image: ${_wic_image}"
	echo "==> Serial console socket: ${_serial_sock}"
	echo "==> Serial transcript:     ${_serial_log}"
	echo "==> QEMU monitor socket:   ${_monitor_sock}"
	echo "==> Guest ssh forwarded to 127.0.0.1:${_ssh_port}"
	echo "==> Attach: socat -,raw,echo=0 UNIX-CONNECT:${_serial_sock}"

	"${_qemu}" \
		"${_qemu_args[@]}" \
		"${_snapshot_args[@]}" \
		-display none \
		-chardev "${_serial_chardev}" \
		-serial chardev:ser0 \
		-monitor "unix:${_monitor_sock},server=on,wait=off"
else
	# --- Interactive mode: SPICE display + serial console ---
	_spice_port=5930

	echo "==> Image: ${_wic_image}"
	echo "==> SPICE display on port ${_spice_port}"
	echo "==> Keyboard release: Shift+F12"
	echo "==> Type 'quit' in this terminal to stop QEMU"

	spicy --host=localhost --port="${_spice_port}" &
	_spicy_pid=$!

	# virt has no VGA; it gets a virtio GPU plus an xHCI keyboard.
	_display_args=(-device qxl-vga)
	if [[ "${_arch}" == "aarch64" ]]; then
		_display_args=(-device virtio-gpu-pci -device qemu-xhci -device usb-kbd -device usb-tablet)
	fi

	"${_qemu}" \
		"${_qemu_args[@]}" \
		"${_snapshot_args[@]}" \
		"${_display_args[@]}" \
		-spice port="${_spice_port}",disable-ticketing=on \
		-serial mon:stdio
fi
