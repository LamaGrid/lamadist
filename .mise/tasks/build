#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#MISE description="Build images for specified BSP"
#USAGE flag "-b --bsp <bsp>" help="BSP target to build" default="x86_64" {
#USAGE   choices "x86_64" "orin-nx" "rk1" "soquartz"
#USAGE }
#USAGE flag "-c --ci" help="CI mode: non-interactive, force checkout"
#USAGE flag "-q --qa" help="QA mode: zstd compression for faster QA/PR builds"
#USAGE flag "-r --release" help="Release mode: machine-default xz compression, CVE checks"
#USAGE flag "-s --include-scans" help="Enable security scans (CVE manifest generation)"
#USAGE flag "-I --icecc" help="Distribute compiles via the icecc helper pool"
#MISE depends=["info"]
set -o errexit
set -o nounset
set -o pipefail

_bsp="${usage_bsp:-x86_64}"
_ci="${usage_ci:-false}"
_qa="${usage_qa:-false}"
_release="${usage_release:-false}"
_include_scans="${usage_include_scans:-false}"
_icecc="${usage_icecc:-false}"

# --release implies --include-scans
if [ "${_release}" = "true" ]; then
	_include_scans="true"
fi

# The icecc scheduler address is site configuration and never lives
# in the repo.  Set LAMADIST_ICECC_SCHEDULER in .mise.local.toml
# (local dev) or a CI secret.  Locally a missing address degrades
# to a plain build; in CI it is a hard error, because inheriting
# the icecc class changes every compile-task signature, so a
# silent degrade flips the whole build into the other sstate
# signature universe and rebuilds ~1100+ tasks inside a green run
# (runs 33688358723 vs 33717639647).
if [ "${_icecc}" = "true" ] && [ -z "${LAMADIST_ICECC_SCHEDULER:-}" ]; then
	if [ "${_ci}" = "true" ]; then
		echo "==> ERROR: --icecc requested but LAMADIST_ICECC_SCHEDULER is unset." >&2
		echo "==> Refusing to silently flip the sstate signature universe;" >&2
		echo "==> restore the CI secret or drop --icecc from the workflow." >&2
		exit 1
	fi
	echo "==> WARNING: LAMADIST_ICECC_SCHEDULER not set; building without icecc"
	_icecc="false"
fi

# shellcheck source=.mise/tasks/_lib.sh
source "${MISE_CONFIG_ROOT}/.mise/tasks/_lib.sh"

# Emit the dynamic KAS overlay (version + build-stats settings) from
# the 'info' dependency task's gitversion env file (see _lib.sh).
write_dynamic_overlay

_kas_config="${KAS_WORK_DIR}/kas/main.kas.yml:${KAS_WORK_DIR}/kas/bsp/${_bsp}.kas.yml:${KAS_WORK_DIR}/.cache/dynamic.kas.yml"

# SBOM fidelity split: every build generates SPDX (distro default
# SPDX_INCLUDE_SOURCES=0 -- cheap, parallel, keeps the CVE scan
# fed), but only release builds pull the sbom overlay that turns
# on full per-source-file inventory.  Sources change SPDX task
# signatures, so release re-runs the SPDX chain cold while reusing
# all compile sstate.  LAMADIST_SPDX_HEAVY tells the dynamic
# overlay to cap do_create_spdx concurrency (2-3 GB per task with
# sources on).
if [ "${_release}" = "true" ]; then
	_kas_config="${_kas_config}:${KAS_WORK_DIR}/kas/extras/sbom.kas.yml"
	export LAMADIST_SPDX_HEAVY=1
fi

# Append build-stage overlays:
#   --qa:      zstd compression (QA/PR builds)
#   --release: no overlay — machine defaults (xz -9e) take effect
#   neither:   debug overlay (local dev, no compression)
if [ "${_qa}" = "true" ] && [ "${_release}" != "true" ]; then
	_kas_config="${_kas_config}:${KAS_WORK_DIR}/kas/extras/qa.kas.yml"
elif [ "${_ci}" != "true" ]; then
	_kas_config="${_kas_config}:${KAS_WORK_DIR}/kas/extras/debug.kas.yml"
fi

# CVE manifest overlay
if [ "${_include_scans}" = "true" ]; then
	_kas_config="${_kas_config}:${KAS_WORK_DIR}/kas/extras/cve.kas.yml"
fi

# icecc overlay: distributed compiles via the lab helper machines
if [ "${_icecc}" = "true" ]; then
	_kas_config="${_kas_config}:${KAS_WORK_DIR}/kas/extras/icecc.kas.yml"
fi

# Non-release builds bake the cached test SSH public key for the
# lama user, same as the installer task (read-only rootfs: keys
# only enter at build time).  Without it an OTA image deployed to
# a lab machine drops key auth, leaving only the dev password.
if [ "${_release}" != "true" ]; then
	ensure_test_ssh_key > /dev/null
	_kas_config="${_kas_config}:${KAS_WORK_DIR}/kas/extras/test-ssh-key.kas.yml"
fi

# Record scan marker for pre-push hook
if [ "${_include_scans}" = "true" ]; then
	mkdir -p "${MISE_CONFIG_ROOT}/.cache"
	git -C "${MISE_CONFIG_ROOT}" rev-parse HEAD > "${MISE_CONFIG_ROOT}/.cache/last-scan-sha" 2>/dev/null || true
fi

if [ "${_ci}" = "true" ]; then
	# CI mode: run kas directly (already inside builder container)
	if [ "${_icecc}" = "true" ]; then
		# CI job pods reach the icecc scheduler and the helper
		# daemons directly.
		# Same root-socket rule as the local path: bitbake gives
		# tasks a throwaway HOME, so only the root daemon's
		# /var/run/icecc socket is findable.  Daemon failure is
		# non-fatal -- compiles fall back to local at the icecc
		# parallelism, contained by the pod's cgroup caps.
		sudo -n mkdir -p /var/run/icecc 2> /dev/null || true
		sudo -n /usr/sbin/iceccd -d --no-remote \
			${LAMADIST_MAX_LOCAL_JOBS:+-m ${LAMADIST_MAX_LOCAL_JOBS}} \
			-s "${LAMADIST_ICECC_SCHEDULER}" ||
			echo "==> WARNING: iceccd failed to start; compiles stay local"
	fi
	mkdir -p "${SSTATE_DIR}"
	kas build --force-checkout --update "${_kas_config}"
else
	# Local dev: run kas inside container via podman/docker

	# Check dependency lockfile freshness
	if ! output=$(mise run container:builder:verify 2>&1); then
		status=$?
		echo "${output}"
		if [ "${status}" -eq 2 ]; then
			exit 1
		fi
	fi

	if [ "${_icecc}" = "true" ]; then
		# icecc needs a local daemon.  Run one inside the container:
		# --no-remote because behind the rootless-podman NAT it cannot
		# accept jobs from other machines, -s because UDP scheduler
		# discovery does not cross the container network namespace.
		# The daemon MUST run as root: a non-root iceccd binds its
		# unix socket at HOME/.iceccd.socket, but bitbake gives
		# every task a private throwaway HOME, so clients never find
		# it and silently compile locally.  Root binds
		# /var/run/icecc/iceccd.socket, the first path every client
		# checks.  LAMADIST_MAX_LOCAL_JOBS (optional; set it in
		# .mise.local.toml) caps the daemon's local compile slots,
		# matching the cap the dynamic overlay puts on plain
		# builds; unset means all container cores.
		run_in_container --entrypoint /bin/dumb-init -- /bin/bash -c "
			mkdir -p /tmp/iceccd
			sudo -n mkdir -p /var/run/icecc
			sudo -n /usr/sbin/iceccd -d --no-remote \
				${LAMADIST_MAX_LOCAL_JOBS:+-m ${LAMADIST_MAX_LOCAL_JOBS}} \
				-s '${LAMADIST_ICECC_SCHEDULER}' \
				-b /tmp/iceccd -l /tmp/iceccd/iceccd.log
			exec kas build '${_kas_config}'
		"
	else
		run_in_container build "${_kas_config}"
	fi
fi
