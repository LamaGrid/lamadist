#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#MISE description="Build the KAS build container image"
#USAGE flag "-c --ci" help="CI mode: rootless container build, push to registry"
set -o errexit
set -o nounset
set -o pipefail

_ci="${usage_ci:-false}"

if [ "${_ci}" = "true" ]; then
	_version_tag="$(date -u +"%Y-%m-%dT%H%M%SZ")"
	_local_image="${LAMADIST_CONTAINER_IMAGE}"
	_build_uid="${BUILDER_UID:-$(id -u)}"

	podman build --format docker --net=host --dns=8.8.8.8 \
		--build-arg BUILDER_UID="${_build_uid}" \
		-t "${_local_image}" "${MISE_CONFIG_ROOT}/container/"

	# Pushing needs the site's registry and its push credential
	# (LAMADIST_REGISTRY, LAMADIST_REGISTRY_USER, and
	# LAMADIST_REGISTRY_PASSWORD).  A run without them builds the image
	# to prove it builds, and does not push it.
	_registry="${LAMADIST_REGISTRY:-}"
	_tls_verify="${LAMADIST_REGISTRY_TLS_VERIFY:-true}"
	if [ -z "${_registry}" ] || [ -z "${LAMADIST_REGISTRY_PASSWORD:-}" ]; then
		echo "==> No registry credential in this run: built, not pushed"
	elif [ -z "${LAMADIST_REGISTRY_USER:-}" ]; then
		echo "==> ERROR: LAMADIST_REGISTRY_USER is unset; not pushing." >&2
		exit 1
	else
		printf '%s' "${LAMADIST_REGISTRY_PASSWORD}" \
			| podman login --tls-verify="${_tls_verify}" --password-stdin \
				-u "${LAMADIST_REGISTRY_USER}" "${_registry}"
		_registry_image="${_registry}/lamagrid/lamadist-builder"
		podman tag "${_local_image}" "${_registry_image}:${_version_tag}"
		podman tag "${_local_image}" "${_registry_image}:latest"
		podman push --tls-verify="${_tls_verify}" "${_registry_image}:${_version_tag}"
		podman push --tls-verify="${_tls_verify}" "${_registry_image}:latest"
		echo "Pushed ${_registry_image}:${_version_tag}"
		echo "Pushed ${_registry_image}:latest"
	fi
else
	"${LAMADIST_CONTAINER_CMD}" build --format docker \
		--build-arg BUILDER_UID="$(id -u)" \
		-t "${LAMADIST_CONTAINER_IMAGE}" "${MISE_CONFIG_ROOT}/container/"
fi
