#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#MISE description="Build the KAS build container image"
#USAGE flag "-c --ci" help="CI mode: container build; push to registry when the registry credential is set"
set -o errexit
set -o nounset
set -o pipefail

_ci="${usage_ci:-false}"

if [ "${_ci}" = "true" ]; then
	# CI runs .mise/lib/builder-ci.sh directly, without mise; this
	# branch runs the same script, with /usr/bin/bash and podman from
	# /usr/bin/podman.
	exec /usr/bin/bash -p "${MISE_CONFIG_ROOT}/.mise/lib/builder-ci.sh"
else
	"${LAMADIST_CONTAINER_CMD}" build --format docker \
		--build-arg BUILDER_UID="$(id -u)" \
		-t "${LAMADIST_CONTAINER_IMAGE}" "${MISE_CONFIG_ROOT}/container/"
fi
