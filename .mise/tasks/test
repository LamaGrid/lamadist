#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#MISE description="Validate build artifacts"
#USAGE flag "-b --bsp <bsp>" help="BSP target to validate" default="x86_64" {
#USAGE   choices "x86_64" "orin-nx" "rk1" "soquartz"
#USAGE }
#USAGE flag "-c --ci" help="CI mode"
#USAGE flag "-n --no-boot" help="Skip the QEMU login smoke test"
#USAGE flag "-S --secureboot" help="Run the login smoke AND the OTA cycle under Secure Boot firmware with the enrolled vars artifact (M4 stage-B gate); build it first with 'mise run ovmf-vars'"
# TODO: Implement CI mode behavior (e.g., machine-readable output, stricter validation)
set -o errexit
set -o nounset
set -o pipefail

_bsp="${usage_bsp:-x86_64}"
_no_boot="${usage_no_boot:-false}"
_secureboot="${usage_secureboot:-false}"

# shellcheck source=.mise/tasks/_lib.sh
source "${MISE_CONFIG_ROOT}/.mise/tasks/_lib.sh"
_machine=$(bsp_to_machine "${_bsp}")
_deploy_dir="${LAMADIST_HOST_DEPLOY_DIR}/images/${_machine}"

echo "==> Checking build artifact directory: ${_deploy_dir}"
if [ ! -d "${_deploy_dir}" ]; then
	echo "ERROR: Deploy directory does not exist: ${_deploy_dir}"
	exit 1
fi

echo "==> Listing build artifacts:"
ls -lh "${_deploy_dir}/"

# Check for WIC image (prefer uncompressed, then newest compressed)
_wic_image=$(find "${_deploy_dir}" -maxdepth 1 -name "*.wic" ! -name "*.wic.*" | sort | tail -1)
if [ -z "${_wic_image}" ]; then
	_wic_image=$(find "${_deploy_dir}" -maxdepth 1 \( -name "*.wic.zst" -o -name "*.wic.xz" -o -name "*.wic.gz" -o -name "*.wic.bz2" \) | sort | tail -1)
fi
if [ -z "${_wic_image}" ]; then
	echo "ERROR: No WIC image found in ${_deploy_dir}"
	exit 1
fi
echo "==> Found WIC image: ${_wic_image}"
echo "==> Size: $(du -h "${_wic_image}" | cut -f1)"

# Check for kernel image
_kernel_image=$(find "${_deploy_dir}" -maxdepth 1 -name "bzImage*" | head -1)
if [ -z "${_kernel_image}" ]; then
	echo "WARNING: No kernel image (bzImage) found in ${_deploy_dir}"
else
	echo "==> Found kernel image: ${_kernel_image}"
fi

echo "==> Build artifact validation passed"

# Boot smoke test: a real serial-console login with command
# execution (see .mise/lib/smoke_login.py).  x86_64 only until
# other BSPs get a QEMU story.
if [ "${_bsp}" = "x86_64" ] && [ "${_no_boot}" != "true" ]; then
	# 600s, not vm's 300s default: the first boot pays one-time
	# costs (LUKS2 format of var, ssh hostkey generation) on top of
	# the normal path, and the M4.A run that led here spent 4:50
	# reaching login and was killed 7s later mid-assertion.
	_vm_args=(--bsp "${_bsp}" --ci --timeout 600)
	[ "${_secureboot}" = "true" ] && _vm_args+=(--secureboot)

	echo "==> Running QEMU login smoke test"
	mise run vm "${_vm_args[@]}"

	# OTA install/rollback test (see .mise/lib/ota_test.py): builds
	# on the login smoke above, so it shares the same skip flag and
	# x86_64-only gate rather than adding a second one.
	# --secureboot extends here too: the M4 stage-B gate is the FULL
	# OTA cycle under Secure Boot (see docs/PLAN.md), so this task
	# with -S runs the complete hardened-profile gate in one shot.
	_ota_args=(--bsp "${_bsp}")
	[ "${_secureboot}" = "true" ] && _ota_args+=(--secureboot)
	echo "==> Running QEMU OTA install/rollback test"
	mise run test-ota "${_ota_args[@]}"
fi
